<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used only to forward DNS queries upstream from the on-device filter. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Not about battery. Android revokes an accessibility service the instant its
      app is force-stopped — measured, not assumed — and the system force-stops
      apps it has decided are idle. Without this, the phone can put the whole
      guard to sleep overnight and say nothing.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        The only sanctioned way to raise a screen from the background. Used for
        exactly one thing: putting the "Guard is off" wall in front of a user
        who asked to be locked in. Android 14 reserves full-screen delivery for
        calling and alarm apps, so elsewhere this degrades to a heads-up notice.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Lets Bastion install its own updates in place, so the app is never
      uninstalled and the covenant, streak and logs are never lost. Only ever
      used against a URL the user has entered themselves.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Recording your "Why" video. Both are optional at runtime. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Grayscale dampening flips the system display daltonizer. This permission is
      NOT grantable from inside the app; it is granted once over adb by the user:
        adb shell pm grant com.bastion.app android.permission.WRITE_SECURE_SETTINGS
      Without it Bastion silently falls back to a dimming veil overlay.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Lets Bastion list launchable apps so you can choose what to guard, without
      taking the far broader QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          And whoever can open a web page, which is how "any browser" stopped
          being a list I maintain. Asking the phone is the only way to cover the
          browser nobody thought of, and that has been the failing case every
          time: the one a man actually reaches for is the one not on the list.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
        supportsRtl is deliberately false.

        Every string in Bastion is written in English, and its layouts are
        composed around that: the rank medallion, the streak ring, the calendar
        and the charts all read left to right. On a phone set to Persian,
        Arabic or Hebrew, Android would mirror the whole interface around
        English text that does not mirror with it — arrows pointing away from
        what they open, the back arrow on the wrong side, charts running
        backwards beneath axis labels that are not.

        A mirrored shell around unmirrored content is worse than no translation
        at all. When Bastion is genuinely localised this flips back on and the
        layouts get done properly.
    -->
    <application
        android:name=".BastionApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Bastion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bastion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The 90 seconds that matter. Must open over the lock screen, instantly. -->
        <activity
            android:name=".feature.panic.PanicActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=".panic"
            android:theme="@style/Theme.Bastion" />

        <!--
            The wall for switching Guard off while locked in.

            Its own task affinity so it cannot be swiped away with whatever the
            user was doing, and singleTask so the watchdog re-launching it
            brings the existing one forward rather than stacking copies.
            Not exported: nothing outside Bastion has any business opening it.
        -->
        <activity
            android:name=".guard.lockdown.LockdownWallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=".lockdownwall"
            android:theme="@style/Theme.Bastion" />
        <activity
            android:name=".guard.lockdown.GuardDownActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:taskAffinity=".guarddown"
            android:theme="@style/Theme.Bastion" />

        <!--
          The wall for opening a settings screen you locked yourself out of.

          Its own taskAffinity, so it never lands inside Settings' back stack —
          leaving it has to go home rather than back to the screen it exists to
          refuse. Deliberately NOT showWhenLocked: this is an interruption, not
          a lockdown, and there is nothing it needs to say over the keyguard.
        -->
        <activity
            android:name=".guard.lockdown.SettingsWallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=".settingswall"
            android:theme="@style/Theme.Bastion" />

        <activity
            android:name=".guard.browser.FilteredBrowserActivity"
            android:exported="false"
            android:label="@string/filtered_browser"
            android:theme="@style/Theme.Bastion" />

        <service
            android:name=".guard.accessibility.BastionAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".guard.vpn.BastionVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device DNS content filter that blocks adult domains. No traffic leaves the device except DNS lookups to the user's chosen resolver." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".feature.panic.PanicTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/panic_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".widget.WatchtowerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchtower_widget_info" />
        </receiver>

        <receiver
            android:name=".core.alarm.BastionBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.alarm.BastionAlarmReceiver"
            android:exported="false" />

        <!-- The minute-by-minute check that runs only while locked in. -->
        <receiver
            android:name=".core.alarm.LockInWatchReceiver"
            android:exported="false" />

        <!--
            The nightly lockout. Not exported: the only thing that may start a
            lockdown from outside the app is the alarm Bastion itself set.
        -->
        <receiver
            android:name=".core.alarm.ScheduledLockdownReceiver"
            android:exported="false" />

        <!-- Outcome of a self-install session; see SelfInstaller. -->
        <receiver
            android:name=".core.update.SelfInstaller$ResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bastion.app.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!--
          Device admin with a single policy: force-lock. Used only to lock the
          screen when a lockdown is triggered. Android reserves powering the
          device off for the OS itself, so this is the closest an installed app
          can legitimately get.
        -->
        <receiver
            android:name=".guard.lockdown.BastionDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Hands the camera a private file to record the "Why" video into. The
          grant is per-URI and temporary; the file never leaves app storage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
