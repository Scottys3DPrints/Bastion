<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used only to forward DNS queries upstream from the on-device filter. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Lets Bastion install its own updates in place, so the app is never
      uninstalled and the covenant, streak and logs are never lost. Only ever
      used against a URL the user has entered themselves.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Recording your "Why" video. Both are optional at runtime. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Grayscale dampening flips the system display daltonizer. This permission is
      NOT grantable from inside the app; it is granted once over adb by the user:
        adb shell pm grant com.bastion.app android.permission.WRITE_SECURE_SETTINGS
      Without it Bastion silently falls back to a dimming veil overlay.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Lets Bastion list launchable apps so you can choose what to guard, without
      taking the far broader QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BastionApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Bastion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bastion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The 90 seconds that matter. Must open over the lock screen, instantly. -->
        <activity
            android:name=".feature.panic.PanicActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=".panic"
            android:theme="@style/Theme.Bastion" />

        <activity
            android:name=".guard.browser.FilteredBrowserActivity"
            android:exported="false"
            android:label="@string/filtered_browser"
            android:theme="@style/Theme.Bastion" />

        <service
            android:name=".guard.accessibility.BastionAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".guard.vpn.BastionVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device DNS content filter that blocks adult domains. No traffic leaves the device except DNS lookups to the user's chosen resolver." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".feature.panic.PanicTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/panic_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".widget.WatchtowerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchtower_widget_info" />
        </receiver>

        <receiver
            android:name=".core.alarm.BastionBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.alarm.BastionAlarmReceiver"
            android:exported="false" />

        <!-- Outcome of a self-install session; see SelfInstaller. -->
        <receiver
            android:name=".core.update.SelfInstaller$ResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.bastion.app.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!--
          Device admin with a single policy: force-lock. Used only to lock the
          screen when a lockdown is triggered. Android reserves powering the
          device off for the OS itself, so this is the closest an installed app
          can legitimately get.
        -->
        <receiver
            android:name=".guard.lockdown.BastionDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Hands the camera a private file to record the "Why" video into. The
          grant is per-URI and temporary; the file never leaves app storage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
